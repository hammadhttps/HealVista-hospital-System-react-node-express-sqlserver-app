NODE_ENV=development
PORT=5000
# Frontend origin(s) allowed by CORS (HTTP + socket.io).
# CLIENT_URL is required; add extra origins (e.g. Vercel preview deploys)
# as a comma-separated list in CORS_ORIGINS.
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=

DATABASE_URL=
DIRECT_URL=

REDIS_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (patients only). GOOGLE_CALLBACK_URL must be the PUBLIC API URL
# of the deployment that serves this request — NOT localhost — or Google rejects
# the redirect_uri. In production set it to the Render API callback, e.g.:
#   GOOGLE_CALLBACK_URL=https://healvista-hospital-system-react-node.onrender.com/api/auth/google/callback
#
# Register BOTH of these in Google Cloud Console → Credentials → OAuth client:
#   Authorized JavaScript origins:
#     http://localhost:5173
#     https://heal-vista-hospital-system-react-no.vercel.app
#   Authorized redirect URIs:
#     http://localhost:5000/api/auth/google/callback
#     https://healvista-hospital-system-react-node.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Jina AI (embeddings + chat/generation). Get a key at https://jina.ai.
# JINA_CHAT_MODEL / JINA_EMBED_MODEL have defaults, so only the key is required.
JINA_API_KEY=
JINA_CHAT_MODEL=jina-vlm
JINA_EMBED_MODEL=jina-embeddings-v5-text-small

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MediCore <no-reply@medicore.app>"
# smtp = send through SMTP above; log = write emails to the server log instead.
# Leave smtp with no SMTP creds set and email jobs are skipped (not failed).
MAILER=smtp

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
