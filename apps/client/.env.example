# Base URL of the MediCore API. Leave unset in local dev to use the Vite proxy (/api → :5000).
# In production builds it defaults to the Render API if unset:
#   VITE_API_URL=https://healvista-hospital-system-react-node.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Socket.io origin. Optional — the client strips /api from VITE_API_URL when unset.
VITE_SOCKET_URL=http://localhost:5000

# Stripe publishable key for online card payments.
VITE_STRIPE_PUBLISHABLE_KEY=
